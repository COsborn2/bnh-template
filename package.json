{
  "name": "create-bnh",
  "bin": {
    "create-bnh": "bin/create.ts"
  },
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "turbo db:generate --filter=@app/migrate",
    "db:migrate": "turbo db:migrate --filter=@app/migrate",
    "db:seed": "turbo db:seed --filter=@app/api",
    "test": "turbo test"
  },
  "overrides": {
    "eslint": "^9.39.4",
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.3",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "nanoid": "^6.0.1",
    "postcss": "^8.5.26"
  }
}
