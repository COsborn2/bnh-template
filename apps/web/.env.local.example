# Cloudflare Turnstile (test keys - always passes)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# App name
NEXT_PUBLIC_APP_NAME=MyApp

# Canonical public origin of the web app, baked in at build time and used for
# metadataBase / Open Graph URLs. Locally this is the dev server; in deployed
# builds set it to the real domain (the same value as BETTER_AUTH_URL) or leave
# it unset until you have one — metadata then falls back to relative URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev only: comma-separated extra origins allowed to reach the Next dev server
# (e.g. testing from a phone on your LAN). No effect in production builds.
# NEXT_ALLOWED_DEV_ORIGINS=http://192.168.1.20:3000
