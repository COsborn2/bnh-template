NEXT_PUBLIC_APP_NAME=MyApp

# Always challenge
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=3x00000000000000000000FF

# Canonical public origin of the web app, baked in at build time and used for
# metadataBase / Open Graph URLs. Locally this is the dev server; in deployed
# builds set it to the real domain (the same value as BETTER_AUTH_URL) or leave
# it unset until you have one — metadata then falls back to relative URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
