# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/myapp

# better-auth
BETTER_AUTH_SECRET=dev-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# Server
PORT=3001

# API log level for the structured JSON logger (error, warn, info, debug)
# LOG_LEVEL=info

# Local-only rate-limit bypass. Production always enforces rate limits.
# Set RATE_LIMITS_DISABLED=true to skip app rate limits in dev.
RATE_LIMITS_DISABLED=false

# App
APP_NAME=MyApp

# Email (Resend)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=MyApp <onboarding@resend.dev>

# Cloudflare Turnstile (test keys - always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis
REDIS_URL=redis://localhost:6379

# WebSocket server (PORT is set in the WS dev script, not here)
WS_AUTH_URL=http://localhost:3001/api/auth/get-session
WS_AUTHORIZE_URL=http://localhost:3001/api/ws/authorize
WS_EVENTS_URL=http://localhost:3001/api/ws/events
WS_API_SECRET=dev-ws-secret-change-in-production

# Observability / distributed tracing (OpenTelemetry)
# Leave everything unset to disable tracing entirely (zero overhead).
#
# Honeycomb (recommended for viewing traces online):
#   HONEYCOMB_API_KEY=your-honeycomb-ingest-key
#   HONEYCOMB_DATASET=myapp                    # optional; omit for env-based datasets
#
# Or any OTLP/HTTP backend (e.g. local Jaeger from docker-compose):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   OTEL_EXPORTER_OTLP_HEADERS=x-api-key=...   # comma-separated key=value
#
# Optional tuning:
#   OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=...     # explicit traces endpoint override
#   OTEL_EXPORTER_OTLP_TIMEOUT=10000           # export timeout in ms
#   OTEL_SERVICE_NAME=...                      # overrides per-service default name
#   OTEL_DB_TRACING=false                      # disable per-query DB spans
#   OTEL_DB_STATEMENT=true                     # attach SQL text to DB spans (off by default)
#   OTEL_LOG_LEVEL=debug                       # verbose OTel diagnostics
HONEYCOMB_API_KEY=
HONEYCOMB_DATASET=
